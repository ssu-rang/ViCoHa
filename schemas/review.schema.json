{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "actionable", "details"],
        "properties": {
          "title": {"type": "string", "pattern": "\\S"},
          "severity": {"type": "string", "pattern": "\\S"},
          "actionable": {"type": "boolean"},
          "details": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
