{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands"],
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "reason", "evidence"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
          "reason": {"type": "string", "pattern": "\\S"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}}
        }
      }
    }
  }
}
